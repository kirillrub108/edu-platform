# Production nginx for Edllm — TLS termination + reverse proxy on a single
# domain. Serves the Nuxt SPA, proxies /api/* to FastAPI, and serves /files/*
# straight from disk guarded by the backend's HMAC signature check
# (auth_request).
#
# This file is an envsubst TEMPLATE. The official nginx image renders
# /etc/nginx/templates/*.template → /etc/nginx/conf.d/ at container start,
# substituting ${DOMAIN} (and ONLY ${DOMAIN} — NGINX_ENVSUBST_FILTER in
# docker-compose.prod.yml restricts it, so nginx's own $host / $remote_addr /
# etc. runtime variables are left untouched). Set the domain once via DOMAIN in
# .env.prod; no edit to this file is needed to run under a different domain. The
# dev nginx/default.conf is a separate file and is left untouched.
#
# The :443 server references the Let's Encrypt cert for ${DOMAIN} — run
# deploy/init-letsencrypt.sh once so the files exist before nginx starts.

# edllm_backend / edllm_frontend live in a generated include, NOT here: they
# name the active blue-green slot, which deploy/deploy.sh rewrites and applies
# with `nginx -s reload` (never a restart — reload keeps established connections
# alive on the old worker until they finish). Slot switching deliberately stays
# out of envsubst: NGINX_ENVSUBST_FILTER is pinned to ${DOMAIN} and must stay
# that way. See docs/DECISIONS.md §53.
include /etc/nginx/upstreams/*.conf;

upstream edllm_grafana {
    server grafana:3000;
}

upstream edllm_flower {
    server flower:5555;
}

# ── :80 — ACME http-01 challenge + redirect everything else to HTTPS ──────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Container liveness probe for the compose healthcheck — no TLS, no upstream.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Let's Encrypt webroot challenge. certbot writes tokens here; nginx and
    # certbot share the certbot_webroot volume.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── :443 — the application ────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Force HTTPS for a year once TLS is confirmed working.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Stream large media (MP4/WAV/PNG) straight from disk for /files/*.
    sendfile on;
    tcp_nopush on;

    # Allow large PPTX/video uploads through to the backend; the upload route
    # enforces the real cap (MAX_VIDEO_UPLOAD_BYTES = 2 GB).
    client_max_body_size 2100m;

    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # ── Maintenance mode ──────────────────────────────────────────────────────
    # Toggled by deploy/maintenance.sh, which creates/removes the flag file in
    # the bind-mounted deploy/maintenance/ directory. The -f test runs per
    # request, so the flag takes effect without a config change; the script still
    # reloads so the switch is deterministic.
    #
    # Fallback path only — a normal release is zero-downtime via the blue-green
    # slots. This exists for releases where that is impossible (a destructive
    # migration, see deploy.sh + DEPLOY_ALLOW_UNSAFE_MIGRATION).
    #
    # `if (...) { return ...; }` is one of the two officially safe uses of `if`
    # inside a location — do not grow these blocks into anything else.
    set $maintenance 0;
    if (-f /etc/nginx/maintenance/ON) {
        set $maintenance 1;
    }

    # Rendered for page requests. `internal` — only reachable as an error_page
    # target. root + exact-match location resolves to
    # /etc/nginx/maintenance/_maintenance.html.
    location = /_maintenance.html {
        internal;
        root /etc/nginx/maintenance;
        default_type "text/html; charset=utf-8";
        add_header Retry-After 300 always;
        add_header Cache-Control "no-store" always;
    }

    # Rendered for /api/* so the SPA can tell planned downtime from a real 5xx.
    # The shape is a contract: `code` stays "maintenance" forever.
    location = /_maintenance.json {
        internal;
        default_type "application/json; charset=utf-8";
        add_header Retry-After 300 always;
        add_header Cache-Control "no-store" always;
        return 503 '{"detail":"Идут технические работы","code":"maintenance","retry_after":300}';
    }

    # ── External health-check -> FastAPI /health ───────────────────────────
    # Отдельно от /healthz на :80 (тот - только "nginx процесс жив", без
    # upstream). Этот путь реально проксирует на backend, используется
    # smoke-тестом деплоя (deploy/deploy.sh).
    location = /health {
        proxy_pass http://edllm_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
        access_log off;
    }

    # ── API → FastAPI ─────────────────────────────────────────────────────────
    location /api/ {
        if ($maintenance = 1) {
            return 503;
        }
        # Catches ONLY the 503 generated above: proxy_intercept_errors stays off
        # (the default), so a genuine 503 from FastAPI passes through untouched.
        error_page 503 /_maintenance.json;

        proxy_pass http://edllm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # ── Signed static delivery (/files/*) — auth_request flow preserved from
    #    the dev nginx/default.conf. The HMAC-SHA256 signature can't be checked
    #    by nginx's secure_link (MD5 only), so a bodyless subrequest hands the
    #    URL to the backend, which re-runs verify_signed_url().
    location /files/ {
        if ($maintenance = 1) {
            return 503;
        }
        error_page 503 /_maintenance.html;

        auth_request /_verify_signature;
        auth_request_set $signed_ttl $upstream_http_x_signed_ttl;
        add_header Cache-Control "public, max-age=$signed_ttl";
        alias /var/www/storage/;
    }

    # ── Protected video delivery (X-Accel-Redirect target) ────────────────────
    # The /api/v1/lessons/.../stream endpoint authorises the request, then returns
    # an empty response carrying `X-Accel-Redirect: /protected-media/<key>`; nginx
    # serves the MP4 from here (Range/sendfile). `internal` means a direct browser
    # hit → 404 — the only way in is through the authorised backend endpoint.
    location /protected-media/ {
        internal;
        alias /var/www/storage/;
    }

    location = /_verify_signature {
        internal;
        proxy_pass http://edllm_backend/internal/files/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    # ── Grafana — metrics dashboards (auth: Grafana login) ────────────────────
    # proxy_pass without a URI component forwards the full request URI unchanged,
    # which is required for GF_SERVER_SERVE_FROM_SUB_PATH to work correctly.
    location /grafana/ {
        proxy_pass http://edllm_grafana;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Flower — Celery monitoring UI (auth: FLOWER_BASIC_AUTH basic auth) ────
    location /flower/ {
        proxy_pass http://edllm_flower;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ── Nuxt SPA (everything else) → Nitro server ──────────────────────────────
    location / {
        if ($maintenance = 1) {
            return 503;
        }
        error_page 503 /_maintenance.html;

        proxy_pass http://edllm_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
